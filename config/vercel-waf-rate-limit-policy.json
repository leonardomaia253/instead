{
  "id": "instead-prod-api-abuse-v1",
  "provider": "vercel-waf",
  "scope": "production",
  "description": "Distributed rate limit policy for public Instead API, auth, webhook, and AI surfaces on Vercel WAF.",
  "deployedVercelRule": {
    "name": "instead-prod-api-abuse-v1",
    "project": "instead",
    "projectId": "prj_QSB3qLIFPJV4r1oe4Vy6iGynrKN6",
    "version": 1,
    "planConstraint": "Vercel Hobby allows one rate-limit rule per project, so the Vercel production rule consolidates the Vercel-routed API surfaces below into one active rule.",
    "match": {
      "pathPrefixes": [
        "/api/admin",
        "/api/affiliates",
        "/api/auth",
        "/api/payments",
        "/api/lending",
        "/api/b2b",
        "/api/community",
        "/api/compliance",
        "/api/discord",
        "/api/health",
        "/api/os",
        "/api/revenue",
        "/api/telegram"
      ]
    },
    "rateLimit": {
      "algorithm": "fixed-window",
      "key": "ip",
      "limit": 60,
      "window": "60s",
      "mitigationStatus": 429
    }
  },
  "rules": [
    {
      "name": "instead-api-public-write",
      "match": {
        "paths": [
          "/api/auth/session",
          "/api/auth/wallet-profile",
          "/api/payments/checkout",
          "/api/payments/status",
          "/api/lending/automation-intents",
          "/api/b2b/widget",
          "/api/affiliates/click",
          "/api/affiliates/me",
          "/api/affiliates/payouts",
          "/api/community/me",
          "/api/community/event",
          "/api/community/vote",
          "/api/community/queue",
          "/api/compliance/verification/session",
          "/api/os/intents",
          "/api/revenue/me"
        ],
        "methods": ["POST", "PUT", "PATCH", "DELETE"]
      },
      "rateLimit": {
        "algorithm": "fixed-window",
        "key": "ip",
        "limit": 60,
        "window": "60s",
        "action": "deny",
        "mitigationStatus": 429
      }
    },
    {
      "name": "instead-webhooks",
      "match": {
        "paths": [
          "/api/telegram/webhook",
          "/api/discord/webhook",
          "/api/payments/webhooks/stripe",
          "/api/payments/webhooks/pagarme",
          "/api/compliance/verification/webhooks/didit"
        ],
        "methods": ["POST"]
      },
      "rateLimit": {
        "algorithm": "fixed-window",
        "key": "ip",
        "limit": 120,
        "window": "60s",
        "action": "deny",
        "mitigationStatus": 429
      }
    },
    {
      "name": "instead-api-admin-read",
      "match": {
        "paths": [
          "/api/admin/affiliates",
          "/api/admin/assisted-deployments",
          "/api/admin/community",
          "/api/admin/operations",
          "/api/admin/prices",
          "/api/admin/revenue",
          "/api/payments/status",
          "/api/revenue/me",
          "/api/compliance/verification/status",
          "/api/health"
        ],
        "methods": ["GET"]
      },
      "rateLimit": {
        "algorithm": "fixed-window",
        "key": "ip",
        "limit": 120,
        "window": "60s",
        "action": "deny",
        "mitigationStatus": 429
      }
    },
    {
      "name": "instead-supabase-ai-functions",
      "match": {
        "hosts": ["wjvrcwvnznkisoerngal.supabase.co"],
        "paths": [
          "/functions/v1/token-ai",
          "/functions/v1/lending-ai",
          "/functions/v1/lending-automation",
          "/functions/v1/balance-monitor"
        ],
        "methods": ["POST"]
      },
      "rateLimit": {
        "algorithm": "fixed-window",
        "key": "ip",
        "limit": 30,
        "window": "60s",
        "action": "deny",
        "mitigationStatus": 429
      },
      "note": "Vercel WAF only protects traffic routed through Vercel-managed domains. If Supabase functions are called directly on supabase.co, mirror this rule in Supabase/in-function limits or proxy calls through the Vercel app domain."
    }
  ],
  "vercelDashboardPath": "Project > Firewall > WAF > Custom Rules > Rate Limit",
  "gateValue": "vercel-waf:instead-prod-api-abuse-v1"
}
