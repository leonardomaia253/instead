{
  "name": "instead-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter instead-frontend build",
    "typecheck": "pnpm --filter instead-frontend exec tsc --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:test:fork": "hardhat test test/InsteadLendingPoolFork.ts",
    "deploy:factory": "hardhat run scripts/deploy-token-factory.ts",
    "deploy:lending": "hardhat run scripts/deploy-lending.ts",
    "deploy:lending-router": "hardhat run scripts/deploy-lending-router.ts",
    "deploy:staking": "hardhat run scripts/deploy-staking.ts",
    "lending:configure-assets": "hardhat run scripts/configure-lending-assets.ts",
    "ownership:transfer": "hardhat run scripts/transfer-ownership.ts",
    "ownership:verify": "node scripts/verify-ownership.mjs",
    "deployments:verify": "node scripts/verify-deployment-manifest.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "smoke:local": "node scripts/local-smoke-test.mjs",
    "db:migrations:check": "node scripts/check-migrations.mjs",
    "db:contract:check": "node scripts/check-supabase-contract.mjs",
    "db:lending-protocols:seed": "node scripts/seed-lending-protocol-routes.mjs",
    "edge:functions:check": "node scripts/check-edge-functions.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.mjs",
    "readiness": "node scripts/production-readiness.mjs",
    "audit:prod": "pnpm audit --prod"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.18.0",
      "postcss": "^8.5.10",
      "sharp": "^0.35.0",
      "uuid": "^11.1.1",
      "ws": "^8.21.0"
    }
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "hardhat": "^2.29.0"
  }
}
